# ============================================================================
# ClassLink 1.0 — Configuration du frontend (SPA React/Vite)
# ----------------------------------------------------------------------------
# COPIER CE FICHIER : `cp .env.example .env` (jamais committer le resultat).
#
# Vite n'injecte dans le bundle que les variables prefixees par `VITE_`.
# Elles sont figees au moment du `npm run build` : une variable ajoutee ici
# apres le build n'a aucun effet, il faut reconstruire.
# ============================================================================

# URL de base de l'API Laravel.
# En développement, laissez vide : le proxy Vite relaie `/api` vers VITE_API_PROXY.
# En production, indiquez l'URL publique de l'API, ex. https://api.classlink.ma/api
VITE_API_URL=

# Cible du proxy de développement (serveur `php artisan serve`).
# Ce proxy supprime la contrainte CORS en local : le navigateur appelle
# `/api/...` sur la meme origine que le frontend.
VITE_API_PROXY=http://127.0.0.1:8000

# Optional local-only role shortcuts. Backend DEV_AUTH_ENABLED must also permit them.
# Never shown by a production build, even if this flag is set.
VITE_DEV_AUTH_ENABLED=false
