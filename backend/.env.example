# ============================================================================
# ClassLink 1.0 — Exemple de configuration backend
# ----------------------------------------------------------------------------
# COPIER CE FICHIER : `cp .env.example .env` (jamais committer le resultat).
#
# Les valeurs ci-dessous correspondent au developpement local. Pour la
# production, se reporter a docs/DEPLOYMENT.md (table des variables Render)
# et a docs/ASSUMPTIONS.md (dependances externes non testees en direct).
# ============================================================================

APP_NAME=ClassLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# URL publique de l'API. Utilisee pour le lien de santé /up et la racine.
APP_URL=http://localhost:8000
# URL(s) du frontend SPA, separees par des virgules si plusieurs origines
# (production + previsualisation). Sert a :
#   - la liste blanche CORS (config/cors.php) ;
#   - les redirections OAuth vers /auth/microsoft/callback, /denied, /pending.
# Ces chemins doivent rester synchronises avec frontend/src/router.tsx.
FRONTEND_URL=http://localhost:5173
# Motif regex d'origines supplementaires, vide par defaut.
# Exemple previsualisation Vercel : ^https://classlink-.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_PATTERNS=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de donnees
# Local : SQLite (fichier database/database.sqlite)
# Production : PostgreSQL (Neon / Aiven / Supabase) ou MySQL managé
# cf. §13.2 du cahier des charges
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# Chemin du certificat d'autorite MySQL, si requis par l'hote.
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# `local` = disque prive du serveur ; `s3` = stockage externe compatible S3.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed worker --timeout=900; run queue:work in a separate terminal.
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Email
# Local : `log` (rien n'est envoye, tout est journalise).
# Production : Brevo en SMTP, ex.
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<identifiant smtp>
#   MAIL_PASSWORD=<cle smtp>
#   MAIL_ENCRYPTION=tls
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@classlink.ma"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Microsoft Entra ID (connexion OAuth 2.0) - §17.3
# L'application doit être enregistrée dans le tenant de l'etablissement.
# L'URI de redirection doit correspondre exactement a AZURE_REDIRECT_URI.
# En production : https://<API>/api/auth/microsoft/callback
# ---------------------------------------------------------------------------
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
AZURE_TENANT_ID=

# ---------------------------------------------------------------------------
# Stockage de fichiers externe compatible S3 - §16
# Aucun fichier n'est servi publiquement : le telechargement passe par la
# route authentifiee GET /api/materials/{id}/download, qui streame le contenu
# apres verification de l'autorisation. Aucune URL temporaire n'est remise au
# client. Le seau doit rester PRIVE.
# R2 / MinIO : renseigner AWS_ENDPOINT et AWS_USE_PATH_STYLE_ENDPOINT.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Plafond de stockage - garde-fou applicatif, en octets.
# Le seau est facture a l'octet : au-dela de cette valeur, les envois de
# fichiers sont refuses (HTTP 507) AVANT toute ecriture.
# 9 Gio = 9 * 1024^3 = 9663676416 octets.
# Le depassement est refuse avant l'ecriture, pas constate apres.
# ---------------------------------------------------------------------------
CLASSLINK_STORAGE_LIMIT_BYTES=9663676416

# ---------------------------------------------------------------------------
# Fournisseurs IA (format "chat completions") - §15.2
# Les cles restent dans l'environnement, jamais en base. La configuration
# d'ordre / activation / quota vit dans la table ai_providers (admin).
# L'ordre de fallback suit la priorite definie en base, pas l'ordre ci-dessous.
# ---------------------------------------------------------------------------
AI_PROVIDER_1_KEY=
AI_PROVIDER_1_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_1_MODEL=gpt-4o-mini

AI_PROVIDER_2_KEY=
AI_PROVIDER_2_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_2_MODEL=llama-3.3-70b-versatile

AI_PROVIDER_3_KEY=
AI_PROVIDER_3_BASE_URL=https://api.mistral.ai/v1
AI_PROVIDER_3_MODEL=mistral-small-latest

# ---------------------------------------------------------------------------
# Taches planifiees - §17.11
# Secret partage entre l'API et les workflows GitHub Actions
# (.github/workflows/daily-digest.yml, prune.yml), envoye dans l'en-tete
# `X-Digest-Token`. Si la valeur est vide, les routes /api/internal/*
# renvoient 404 : elles sont alors fermees. Generer avec :
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
DIGEST_TOKEN=

# ---------------------------------------------------------------------------
# Execution locale (jamais actif en production) - §25
# Autorise POST /api/auth/dev/login pour obtenir un jeton sur un compte de
# demonstration, sans Microsoft ni email. Refuse si APP_ENV=production.
# ---------------------------------------------------------------------------
DEV_AUTH_ENABLED=true

# Aucune variable `VITE_*` n'est lue par l'API : le frontend lit son propre
# `frontend/.env` (VITE_API_URL). Voir frontend/.env.example.
